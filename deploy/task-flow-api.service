# T13: App 서버에서 Task Flow API를 실행하는 systemd 서비스.
# 설치: sudo ./scripts/setup_app_server.sh (이 파일을 /etc/systemd/system/에 복사한다)
# DB 접속 정보는 코드 폴더의 .env가 아닌 /etc/task-flow/api.env에서 읽는다.
[Unit]
Description=Task Flow API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 코드·가상환경은 root 소유로 두고, 서비스는 쓰기 권한 없는 전용 사용자로 실행한다.
User=taskflow
Group=taskflow
WorkingDirectory=/opt/task-flow
EnvironmentFile=/etc/task-flow/api.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# T14에서 Web 서버의 Nginx가 이 포트로 프록시한다. 8000번은 보안그룹·방화벽에서 Web 서버만 허용한다.
ExecStart=/opt/task-flow/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
